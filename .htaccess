# ============================================================
#  brunotte.de auf Apache (STRATO)
#  Ersetzt vercel.json. Vercel hat Weiterleitungen und
#  Komprimierung automatisch gemacht - hier steht beides explizit.
# ============================================================

AddDefaultCharset UTF-8
DirectoryIndex index.html
Options -Indexes

# ------------------------------------------------------------
#  Einheitliche Adresse: immer www.brunotte.de
#
#  HTTPS wird bewusst NICHT hier erzwungen, sondern ueber die
#  Einstellung im STRATO-Kundenbereich. Auf geteiltem Hosting
#  laesst sich nicht zuverlaessig erkennen, ob die Verbindung
#  schon verschluesselt ist - eine Regel dafuer kann in eine
#  Endlosweiterleitung laufen.
# ------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Unverschluesselte Aufrufe auf https umleiten.
  # Bedingung ist der Port, nicht %{HTTPS}: Letzteres ist auf geteiltem
  # Hosting nicht zuverlaessig und kann eine Endlosschleife ausloesen.
  RewriteCond %{SERVER_PORT} ^80$
  RewriteRule ^ https://www.brunotte.de%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} !^www\.brunotte\.de$ [NC]
  # Testadresse ausgenommen, damit sich die Seite auf dem Webspace pruefen
  # laesst, ohne die Hauptdomain umzustellen.
  RewriteCond %{HTTP_HOST} !^test\.brunotte\.de$ [NC]
  RewriteCond %{HTTP_HOST} !^$
  RewriteRule ^ https://www.brunotte.de%{REQUEST_URI} [R=301,L]
</IfModule>

# ------------------------------------------------------------
#  Zwischenspeicherung im Browser
# ------------------------------------------------------------
<IfModule mod_headers.c>

  # Browser sollen diese Seite nur noch verschluesselt aufrufen.
  # Erst gesetzt, nachdem das Zertifikat nachweislich funktioniert.
  Header always set Strict-Transport-Security "max-age=63072000"

  # Die Testadresse darf nicht in Suchmaschinen landen - sonst steht die
  # Seite doppelt im Netz.
  SetEnvIf Host ^test\. IST_TEST
  Header set X-Robots-Tag "noindex, nofollow" env=IST_TEST

  # Schriften aendern sich praktisch nie: ein Jahr, ohne Rueckfrage.
  # Wird eine Schrift je ausgetauscht, muss der Dateiname mitgeaendert
  # werden - sonst sehen wiederkehrende Besucher die alte.
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Bilder: eine Woche. Kurz genug, um das Portraet tauschen zu koennen.
  <FilesMatch "\.(jpg|jpeg|png|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # Seiten und Stil immer frisch pruefen - sonst kommen Textaenderungen
  # bei wiederkehrenden Besuchern tagelang nicht an.
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

</IfModule>

# ------------------------------------------------------------
#  Komprimierung (woff2 ist bereits komprimiert und bleibt aussen vor)
# ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------------------------
#  Korrekter Typ fuer Schriftdateien, falls der Server ihn nicht kennt
# ------------------------------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>
